@startuml
actor Doctor
participant "OperationRequestController" as ORC
participant "IOperationRequestService" as ORS
participant "OperationRequestRepository" as ORR

Doctor -> ORC : ListOperationRequests(searchCriteria)
ORC -> ORS : ListOperationRequests(searchCriteria)
ORS -> ORR : GetRequestsByCriteria(searchCriteria)

alt Requests found
    ORR --> ORS : List<OperationRequest>
    ORS --> ORC : List<OperationRequest>
    ORC --> Doctor : Display(List<OperationRequest>)
else No requests found
    ORS --> ORC : EmptyResult
    ORC --> Doctor : Display("No operation requisitions found")
end
@enduml
