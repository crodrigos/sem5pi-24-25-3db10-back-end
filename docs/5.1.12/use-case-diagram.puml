@startuml
actor Admin

rectangle "Staff Management System" {
    usecase "Create New Staff Profile" as UC1
    usecase "Validate Staff Information" as UC2
    usecase "Store Staff Information" as UC3
}

Admin --> UC1 : "Requests to create a new profile"
UC1 --> UC2 : "Validates input data"
UC2 --> UC3 : "If valid, stores information"
UC3 --> Admin : "Confirms profile creation"

note right of UC1
  Preconditions:
  - Admin is logged into the system.
  - Admin has necessary permissions.

  Postconditions:
  - New staff profile is created and stored in the system.
  - Admin receives confirmation of the creation.
end note

@enduml
